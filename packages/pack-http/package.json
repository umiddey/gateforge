{
  "name": "@gate-forge/pack-http",
  "version": "0.6.2",
  "license": "Apache-2.0",
  "description": "Generic HTTP exposure pack: TS detector for route registrations (Express, Fastify, Hono, NestJS), bounded static dataflow for frontend API-client calls (fetch, Axios, instances, wrappers, constants, URL builders), http.contract evidence facts plus exposure/lifecycle signals (ADR 0004, plan phases 3-4).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate-forge/core": "^0.6.2",
    "@gate-forge/http-contract": "^0.6.2",
    "@gate-forge/plugin-protocol": "^0.6.2",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/gateforge.git",
    "directory": "packages/pack-http"
  },
  "bugs": {
    "url": "https://github.com/umiddey/gateforge/issues"
  },
  "homepage": "https://github.com/umiddey/gateforge#readme"
}
