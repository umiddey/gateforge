{
  "name": "@gate-forge/pack-alembic",
  "version": "0.8.0",
  "license": "Apache-2.0",
  "description": "Alembic migration obligations pack: static lineage verification, engine-run roundtrip on disposable database, data-preservation checks, and multi-developer merge safety.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "python",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate-forge/core": "^0.8.0",
    "@gate-forge/plugin-protocol": "^0.8.0",
    "zod": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/gateforge.git",
    "directory": "packages/pack-alembic"
  },
  "bugs": {
    "url": "https://github.com/umiddey/gateforge/issues"
  },
  "homepage": "https://github.com/umiddey/gateforge#readme"
}
