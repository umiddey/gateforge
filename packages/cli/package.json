{
  "name": "@gate-forge/cli",
  "version": "0.6.2",
  "license": "Apache-2.0",
  "description": "Gateforge CLI: init, discover, obligations, check, test-gates, baseline update.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gateforge": "./bin/gateforge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "npm run build -w @gate-forge/core && npm run build -w @gate-forge/plugin-protocol",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate-forge/core": "^0.6.2",
    "@gate-forge/http-contract": "^0.6.2",
    "@gate-forge/pack-fastapi": "^0.6.2",
    "@gate-forge/pack-http": "^0.6.2",
    "@gate-forge/pack-playwright": "^0.6.2",
    "@gate-forge/pack-sqlalchemy": "^0.6.2",
    "@gate-forge/pack-task": "^0.6.2",
    "@gate-forge/plugin-protocol": "^0.6.2",
    "picomatch": "^4.0.7",
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/gateforge.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/umiddey/gateforge/issues"
  },
  "homepage": "https://github.com/umiddey/gateforge#readme"
}
