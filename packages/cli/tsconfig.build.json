{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false,
    "outDir": "dist"
  },
  "include": ["src"],
  // Colocated src unit tests run under vitest (see vitest.config.ts
  // include) and import test/ helpers — never shipped in dist.
  "exclude": ["src/**/*.test.ts"]
}