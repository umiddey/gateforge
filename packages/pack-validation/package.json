{
  "name": "@gate-forge/pack-validation",
  "version": "0.6.2",
  "license": "Apache-2.0",
  "description": "Validation discovery pack: TS-only AST-light detector (GPP/3) for zod / joi / yup / class-validator request schemas; boundary + side-effect contracts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate-forge/core": "^0.6.2",
    "@gate-forge/plugin-protocol": "^0.6.2"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/gateforge.git",
    "directory": "packages/pack-validation"
  },
  "bugs": {
    "url": "https://github.com/umiddey/gateforge/issues"
  },
  "homepage": "https://github.com/umiddey/gateforge#readme"
