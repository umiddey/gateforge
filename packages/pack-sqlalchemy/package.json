{
  "name": "@gate-forge/pack-sqlalchemy",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "description": "SQLAlchemy CRUD discovery pack: AST-only python detector (GPP/3), in-process TS discover entry, configurable plane mapping, entity-adapter schema.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "examples",
    "python"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate-forge/core": "^0.4.0",
    "@gate-forge/plugin-protocol": "^0.4.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/gateforge.git",
    "directory": "packages/pack-sqlalchemy"
  },
  "bugs": {
    "url": "https://github.com/umiddey/gateforge/issues"
  },
  "homepage": "https://github.com/umiddey/gateforge#readme"
}
