{
  "name": "@gate-forge/pack-playwright",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Gateforge Playwright evidence pack: loopback witness service, engine-side adapter execution, trusted evidence fixture, verdict reporter.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gateforge-witness": "./bin/gateforge-witness.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter/reporter.d.ts",
      "require": "./dist/reporter/reporter.cjs",
      "import": "./dist/reporter/reporter.js"
    },
    "./fixture": {
      "types": "./dist/fixture/fixture.d.ts",
      "import": "./dist/fixture/fixture.js"
    },
    "./witness": {
      "types": "./dist/witness/server.d.ts",
      "import": "./dist/witness/server.js"
    },
    "./attestation": {
      "types": "./dist/attestation/proxy.d.ts",
      "import": "./dist/attestation/proxy.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "python"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gate-forge/core": "^0.1.0",
    "playwright": "1.58.2",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/gateforge.git",
    "directory": "packages/pack-playwright"
  },
  "bugs": {
    "url": "https://github.com/umiddey/gateforge/issues"
  },
  "homepage": "https://github.com/umiddey/gateforge#readme"
}
