{
  "name": "gateforge",
  "version": "0.10.1",
  "private": true,
  "description": "Converts recognized source artifacts into explicit, machine-verifiable test obligations.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/plugin-protocol",
    "packages/http-contract",
    "packages/pack-auth",
    "packages/pack-fastapi",
    "packages/pack-http",
    "packages/witness",
    "packages/pack-playwright",
    "packages/pack-alembic",
    "packages/pack-sqlalchemy",
    "packages/pack-task",
    "packages/pack-validation",
    "packages/pack-webhook",
    "packages/pack-workflow",
    "packages/cli"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "license:sync": "for p in packages/*/; do cp LICENSE \"$p\"; done",
    "publish:all": "npm run build --workspaces --if-present && npm run license:sync && bash scripts/release-publish.sh",
    "pack:check": "npm run build --workspaces --if-present && npm run license:sync && npm pack --dry-run --workspaces && bash scripts/release-publish.sh check"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "supertest": "^7.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "check-error": "^2.1.3",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.2",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "js-tokens": "^9.0.1",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.18",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "playwright": "^1.58.2",
    "playwright-core": "^1.58.2",
    "postcss": "^8.5.26",
    "rollup": "^4.63.1",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tinypool": "^1.1.1",
    "tinyrainbow": "^2.0.0",
    "tinyspy": "^4.0.4",
    "undici-types": "^7.18.2",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "keywords": [],
  "author": ""
}
