# Authority environment template (plan Phase 10).
# Copy to the controller's protected env (outside every candidate
# boundary), fill in, and NEVER commit filled values.
#
# GATEFORGE_AUTHORITY_BOUNDARY
#   Set to `managed-authoritative` on the protected authority. The
#   broker then rejects any receipt whose execution boundary is
#   `local-unisolated` (fail closed).
GATEFORGE_AUTHORITY_BOUNDARY=managed-authoritative

# GATEFORGE_WITNESS_VERIFIER_KEY
#   The witness verifier secret (the same authority as witness records).
#   Owner-generated; shared with the witness and the evaluating CLI,
#   never with the tested suite or the candidate.
GATEFORGE_WITNESS_VERIFIER_KEY=<owner-generated-64-hex>

# GATEFORGE_APPROVED_POLICY_DIGEST
#   64-hex digest of the approved policy/behavior bundle revision. A
#   candidate whose recomputed trusted policy digest differs is a typed
#   ENFORCEMENT_UNTRUSTED rejection.
GATEFORGE_APPROVED_POLICY_DIGEST=<64-hex-approved-revision>

# GATEFORGE_AUTHORITY_HOSTING_PROJECT / GATEFORGE_AUTHORITY_PROTECTED_REF
#   Owner-provisioned disposable hosting project and protected ref the
#   broker CAS-updates. Provisioned by the host administrator; never
#   writable by agents or workers.
